# =============================================================================
# Kalshi credentials
# Generate an RSA key pair: openssl genrsa -out kalshi_private_key.pem 2048
# Upload the PUBLIC key in the Kalshi web console under API Settings.
# =============================================================================
KALSHI_API_KEY_ID=your_api_key_id_here
KALSHI_PRIVATE_KEY_PATH=./kalshi_private_key.pem
KALSHI_BASE_URL=https://api.kalshi.com/trade-api/v2
KALSHI_WS_URL=wss://api.kalshi.com/trade-api/ws/v2
KALSHI_DEMO_MODE=false

# =============================================================================
# Polymarket credentials
# Export your private key from MetaMask: Account Details -> Export Private Key
# The funder address is the wallet address that holds your USDC on Polygon.
# NOTE: Polymarket is geo-restricted in some regions. Enable your VPN BEFORE
# starting the bot. The bot checks connectivity at startup and exits if
# Polymarket is unreachable.
# =============================================================================
POLYMARKET_PRIVATE_KEY=0x_your_private_key_here
POLYMARKET_FUNDER_ADDRESS=0x_your_wallet_address_here
POLYMARKET_CLOB_HOST=https://clob.polymarket.com
POLYMARKET_GAMMA_HOST=https://gamma-api.polymarket.com
POLYMARKET_CHAIN_ID=137
POLYMARKET_VERSION=international

# Check Polymarket is reachable before starting (requires VPN in restricted regions)
POLYMARKET_CONNECTIVITY_CHECK=true
CONNECTIVITY_TIMEOUT=10

# =============================================================================
# Market category filter
# Only trade markets in these categories. Comma-separated.
# Kalshi names: Sports, Football, Basketball, Baseball, Hockey, Soccer, Tennis, Golf
# Polymarket name: Sports
# =============================================================================
MARKET_CATEGORIES=sports

# =============================================================================
# Bot settings
# =============================================================================
DRY_RUN=true
MIN_EDGE_AFTER_FEES=0.035
MAX_POSITION_PER_MARKET=10
MAX_GLOBAL_EXPOSURE=100
MAX_DAILY_LOSS=10
SCAN_INTERVAL_SECONDS=2
MIN_FILL_RATIO=0.90
ALERT_WEBHOOK_URL=

# =============================================================================
# Dashboard
# =============================================================================
DASHBOARD_HOST=localhost
DASHBOARD_PORT=8000
