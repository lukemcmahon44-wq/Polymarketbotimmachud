# Polymarket Bot Environment Variables
# Copy to .env and fill in values. NEVER commit .env to version control.

# ─── Polymarket API ──────────────────────────────────────────────
POLYMARKET_API_KEY=
POLYMARKET_SECRET=
POLYMARKET_PASSPHRASE=
POLYMARKET_CLOB_URL=https://clob.polymarket.com
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com

# ─── Wallet / Signing ───────────────────────────────────────────
# NEVER hardcode. Use a secrets manager in production.
PRIVATE_KEY=
WALLET_ADDRESS=
POLYGON_RPC_URL=https://polygon-rpc.com

# ─── Live Trading Gate ───────────────────────────────────────────
ENABLE_LIVE_TRADING=false

# ─── Monitoring ──────────────────────────────────────────────────
ALERT_WEBHOOK_URL=
LOG_LEVEL=INFO

# ─── Optional ────────────────────────────────────────────────────
ETHERSCAN_API_KEY=
POLYGONSCAN_API_KEY=
