# Polymarket Bot Environment Variables
# NEVER commit real secrets. Copy this file to .env and fill in values.

# --- Polymarket CLOB API ---
POLYMARKET_HOST=https://clob.polymarket.com
POLYMARKET_CHAIN_ID=137

# Private key for signing transactions (NEVER hardcode)
# Use a dedicated bot wallet with limited funds
POLYMARKET_PRIVATE_KEY=
POLYMARKET_FUNDER_ADDRESS=
POLYMARKET_SIGNATURE_TYPE=1

# --- Polygon RPC Provider ---
POLYGON_RPC_URL=https://polygon-rpc.com
POLYGON_WS_URL=wss://polygon-bor-rpc.publicnode.com

# --- Live Trading Gate ---
# Both ENABLE_LIVE_TRADING=true AND a runtime passphrase are required
ENABLE_LIVE_TRADING=false

# --- Alert Webhooks (optional) ---
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
ALERT_EMAIL=

# --- Config Override ---
CONFIG_PATH=config/default.yaml
